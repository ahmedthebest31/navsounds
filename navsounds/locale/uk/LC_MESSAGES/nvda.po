#: NavigationSounds/__init__.py:46 NavigationSounds/settings.py:19
#: NavigationSounds/settings.py:45
msgid "navigation sounds"
msgstr "звуки навігації"

#: NavigationSounds/__init__.py:327
msgid "Disable navigation sounds"
msgstr "Вимкнути звуки навігації"

#: NavigationSounds/__init__.py:334
msgid "Enable navigation sounds"
msgstr "Увімкнути звуки навігації"

#: NavigationSounds/__init__.py:344
msgid "Disable typing sounds"
msgstr "Вимкнути звуки введення"

#: NavigationSounds/__init__.py:346
msgid "Enable typing sounds"
msgstr "Увімкнути звуки введення"

#: NavigationSounds/__init__.py:352
msgid ""
"Pressing it once toggles between on and off object sounds, and Pressing "
"twice  it toggles between on and off typing sounds."
msgstr ""
"Одноразове натискання вмикає й вимикає звуки об’єктів, а подвійне натискання "
"вмикає й вимикає звуки введення."

#: NavigationSounds/settings.py:34
msgid "select sound"
msgstr "вибрати звук"

#: NavigationSounds/settings.py:39
msgid "say element roles"
msgstr "промовляти ролі елементів"

#: NavigationSounds/settings.py:42
msgid "say element states"
msgstr "промовляти стани елементів"

#: NavigationSounds/settings.py:48
msgid "play sounds on mouse hover"
msgstr "відтворювати звук при наведенні миші"

#: NavigationSounds/settings.py:52
msgid "mouse hover delay (ms)"
msgstr "затримка при наведенні миші (мс)"

#: NavigationSounds/settings.py:61
msgid "keyboard typing sound"
msgstr "звук набору тексту на клавіатурі"

#: NavigationSounds/settings.py:65
msgid "enable typing sound in text boxes only"
msgstr "увімкнути звук введення лише в текстових полях"

#: NavigationSounds/settings.py:68
msgid "select typing sound"
msgstr "вибрати звук введення"

#: NavigationSounds/settings.py:79
msgid "play navigation sounds during arrow key navigation"
msgstr ""
"відтворювати звуки навігації під час навігації за допомогою клавіш зі "
"стрілками"

#: NavigationSounds/settings.py:82
msgid "volume"
msgstr "гучність"

#: NavigationSounds/settings.py:85
msgid "open sounds folder"
msgstr "відкрити папку звуків"

#: NavigationSounds/settings.py:88
msgid "donate"
msgstr "пожертвувати"

#~ msgid "Disable sayRoles"
#~ msgstr "Вимкнути озвучення ролей"

