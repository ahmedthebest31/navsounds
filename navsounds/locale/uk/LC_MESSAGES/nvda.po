#: navsounds/globalPlugins/NavigationSounds/__init__.py
msgid "navigation sounds"
msgstr "звуки навігації"

#: navsounds/globalPlugins/NavigationSounds/__init__.py
msgid "Disable navigation sounds"
msgstr "Вимкнути звуки навігації"

#: navsounds/globalPlugins/NavigationSounds/__init__.py
msgid "Enable navigation sounds"
msgstr "Увімкнути звуки навігації"

#: navsounds/globalPlugins/NavigationSounds/__init__.py
msgid "Disable typing sounds"
msgstr "Вимкнути звуки введення"

#: navsounds/globalPlugins/NavigationSounds/__init__.py
msgid "Enable typing sounds"
msgstr "Увімкнути звуки введення"

#: navsounds/globalPlugins/NavigationSounds/__init__.py
msgid ""
"Pressing it once toggles between on and off object sounds, and Pressing "
"twice  it toggles between on and off typing sounds."
msgstr ""
"Одноразове натискання вмикає й вимикає звуки об’єктів, а подвійне натискання "
"вмикає й вимикає звуки введення."

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "select sound"
msgstr "вибрати звук"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "say element roles"
msgstr "промовляти ролі елементів"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "say element states"
msgstr "промовляти стани елементів"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "play sounds on mouse hover"
msgstr "відтворювати звук при наведенні миші"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "mouse hover delay (ms)"
msgstr "затримка при наведенні миші (мс)"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "keyboard typing sound"
msgstr "звук набору тексту на клавіатурі"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "enable typing sound in text boxes only"
msgstr "увімкнути звук введення лише в текстових полях"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "select typing sound"
msgstr "вибрати звук введення"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "play navigation sounds during arrow key navigation"
msgstr ""
"відтворювати звуки навігації під час навігації за допомогою клавіш зі "
"стрілками"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "volume"
msgstr "гучність"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "open sounds folder"
msgstr "відкрити папку звуків"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "donate"
msgstr "пожертвувати"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "choose how you would like to donate"
msgstr "виберіть, як ви хочете зробити пожертву"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "close"
msgstr "закрити"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "do not show this again"
msgstr "не показувати це знову"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "donate with InstaPay Egypt"
msgstr "пожертвувати через InstaPay Egypt"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "donate with PayPal"
msgstr "пожертвувати через PayPal"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "import sound theme..."
msgstr "імпортувати звукову тему..."

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "navigation sounds (roles and states)"
msgstr "звуки навігації (ролі та стани)"

#: navsounds/globalPlugins/NavigationSounds/theme_import.py
msgid "no free name was found for the imported theme"
msgstr "не знайдено вільної назви для імпортованої теми"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "open bundled sounds folder"
msgstr "відкрити папку зі звуками"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "open sound theme archive"
msgstr "відкрити архів звукових тем"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "open theme store"
msgstr "відкрити магазин тем"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "open themes folder"
msgstr "відкрити папку тем"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "support navSounds development"
msgstr "підтримати розробку додатка"

#: navsounds/globalPlugins/NavigationSounds/theme_import.py
msgid "the archive contains an absolute path"
msgstr "архів містить абсолютний шлях"

#: navsounds/globalPlugins/NavigationSounds/theme_import.py
msgid "the archive contains an unsafe path"
msgstr "архів містить небезпечний шлях"

#: navsounds/globalPlugins/NavigationSounds/theme_import.py
msgid "the archive contains no readable sound files"
msgstr "архів не містить читабельних звукових файлів"

#: navsounds/globalPlugins/NavigationSounds/theme_import.py
msgid "the archive contains no sound files"
msgstr "архів не містить звукових файлів"

#: navsounds/globalPlugins/NavigationSounds/theme_import.py
msgid "the archive contains too many items"
msgstr "архів містить забагато елементів"

#: navsounds/globalPlugins/NavigationSounds/theme_import.py
msgid "the archive could not be read: {}"
msgstr "не вдалося прочитати архів: {}"

#: navsounds/globalPlugins/NavigationSounds/theme_import.py
msgid "the archive is too large to import"
msgstr "архів занадто великий для імпорту"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "the bundled sounds folder could not be opened"
msgstr "не вдалося відкрити папку з вбудованими звуками"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "the bundled sounds folder is opened"
msgstr "відкрито папку з вбудованими звуками"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "the donation page could not be opened"
msgstr "не вдалося відкрити сторінку для пожертв"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "the donation page is opened in your web browser"
msgstr "сторінка для пожертв відкривається у вашому браузері"

#: navsounds/globalPlugins/NavigationSounds/theme_import.py
msgid "the selected archive does not exist"
msgstr "вибраний архів не існує"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "the theme could not be imported: {}"
msgstr "не вдалося імпортувати тему: {}"

#: navsounds/globalPlugins/NavigationSounds/theme_import.py
msgid "the theme could not be installed: {}"
msgstr "не вдалося встановити тему : {}"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "the theme store could not be opened, visit {}"
msgstr "не вдалося відкрити магазин тем, відвідайте {}"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "the theme store is opened in your web browser"
msgstr "магазин тем відкрито у вашому браузері"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "the themes folder could not be opened"
msgstr "папку з темами не вдалося відкрити"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "the themes folder is opened, your imported themes are inside it"
msgstr "папку тем відкрито, імпортовані теми знаходяться всередині неї"

#: navsounds/globalPlugins/NavigationSounds/theme_import.py
msgid "the user themes folder could not be created: {}"
msgstr "не вдалося створити папку тем користувача: {}"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "theme '{}' was imported with {} sound files"
msgstr "тему '{}' імпортовано разом із {} звуковими файлами"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "theme archives"
msgstr "архіви тем"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "theme type"
msgstr "тип теми"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "typing sounds (keyboard)"
msgstr "звуки набору тексту (клавіатура)"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "which sounds does '{}' contain?"
msgstr "які звуки є в '{}' ?"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "{} unusable file was skipped."
msgstr "{} Непридатний файл було пропущено."

