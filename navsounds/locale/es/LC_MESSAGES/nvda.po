#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "donate"
msgstr "hacer una donación"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "choose how you would like to donate"
msgstr "elige cómo quieres hacer tu donación"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "close"
msgstr "cerrar"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "do not show this again"
msgstr "no volver a mostrar"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "donate with InstaPay Egypt"
msgstr "donar con InstaPay Egypt"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "donate with PayPal"
msgstr "donar con PayPal"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "import sound theme..."
msgstr "importar tema de sonidos..."

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "navigation sounds (roles and states)"
msgstr "sonidos de navegación (roles y estados)"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid ""
"navSounds is free, and it always will be. A lot of work went into keeping it "
"fast, light and reliable on every device, including yours. If you like it, a "
"small donation helps that work continue."
msgstr ""
"navSounds es gratuito y siempre lo será. Se ha dedicado mucho trabajo a "
"mantenerlo rápido, ligero y fiable en todos los dispositivos, incluido el "
"tuyo. Si te gusta, una pequeña donación ayuda a que ese trabajo continúe."

