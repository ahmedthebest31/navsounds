#: navsounds/globalPlugins/NavigationSounds/__init__.py
msgid "navigation sounds"
msgstr "sonidos de navegación"

#: navsounds/globalPlugins/NavigationSounds/__init__.py
msgid "Disable navigation sounds"
msgstr "Deshabilitar sonidos de navegación"

#: navsounds/globalPlugins/NavigationSounds/__init__.py
msgid "Enable navigation sounds"
msgstr "Habilitar sonidos de navegación"

#: navsounds/globalPlugins/NavigationSounds/__init__.py
msgid "Disable typing sounds"
msgstr "Deshabilitar sonidos de escritura"

#: navsounds/globalPlugins/NavigationSounds/__init__.py
msgid "Enable typing sounds"
msgstr "Habilitar sonidos de escritura"

#: navsounds/globalPlugins/NavigationSounds/__init__.py
msgid ""
"Pressing it once toggles between on and off object sounds, and Pressing "
"twice  it toggles between on and off typing sounds."
msgstr ""
"Al presionarlo una vez se alterna entre activar y desactivar los sonidos de "
"los objetos, y al presionarlo dos veces se alterna entre activar y "
"desactivar los sonidos de escritura."

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "select sound"
msgstr "seleccionar sonido"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "say element roles"
msgstr "anunciar los roles de los elementos"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "say element states"
msgstr "anunciar los estados de los elementos"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "play sounds on mouse hover"
msgstr "reproducir sonidos al pasar el ratón por encima"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "mouse hover delay (ms)"
msgstr "retardo al pasar el ratón (ms)"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "keyboard typing sound"
msgstr "sonido de escritura del teclado"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "enable typing sound in text boxes only"
msgstr "habilitar el sonido de escritura solo en cuadros de texto"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "select typing sound"
msgstr "seleccionar sonido de escritura"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "play navigation sounds during arrow key navigation"
msgstr "reproducir sonidos de navegación al navegar con las flechas"

