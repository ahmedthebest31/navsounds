#: navsounds/globalPlugins/NavigationSounds/__init__.py
msgid "navigation sounds"
msgstr "âm thanh điều hướng"

#: navsounds/globalPlugins/NavigationSounds/__init__.py
msgid "Disable navigation sounds"
msgstr "Tắt âm thanh điều hướng"

#: navsounds/globalPlugins/NavigationSounds/__init__.py
msgid "Enable navigation sounds"
msgstr "Bật âm thanh điều hướng"

#: navsounds/globalPlugins/NavigationSounds/__init__.py
msgid "Disable typing sounds"
msgstr "Tắt âm thanh gõ"

#: navsounds/globalPlugins/NavigationSounds/__init__.py
msgid "Enable typing sounds"
msgstr "Bật âm thanh gõ"

#: navsounds/globalPlugins/NavigationSounds/__init__.py
msgid ""
"Pressing it once toggles between on and off object sounds, and Pressing "
"twice  it toggles between on and off typing sounds."
msgstr ""
"Nhấn một lần để chuyển đổi giữa bật và tắt âm thanh của đối tượng và Nhấn "
"hai lần để chuyển đổi giữa bật và tắt âm thanh gõ."

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "select sound"
msgstr "chọn âm thanh"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "say element roles"
msgstr "nói vai trò của phần tử"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "say element states"
msgstr "nói trạng thái phần tử"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "play sounds on mouse hover"
msgstr "phát âm thanh khi di chuột"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "mouse hover delay (ms)"
msgstr "độ trễ khi di chuột (ms)"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "keyboard typing sound"
msgstr "âm thanh gõ bàn phím"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "enable typing sound in text boxes only"
msgstr "chỉ bật âm thanh gõ trong hộp văn bản"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "select typing sound"
msgstr "chọn âm thanh gõ"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "play navigation sounds during arrow key navigation"
msgstr "phát âm thanh điều hướng trong khi điều hướng bằng phím mũi tên"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "volume"
msgstr "âm lượng"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "open sounds folder"
msgstr "mở thư mục âm thanh"

#: navsounds/globalPlugins/NavigationSounds/settings.py
msgid "donate"
msgstr "quyên góp"
